# KEGGPathRank Environment Configuration
# Copy this file to .env and adjust values as needed.
# No secrets are required — the KEGG REST API is public.

# KEGG API
KEGG_API_BASE_URL=https://rest.kegg.jp
KEGG_REQUEST_TIMEOUT=30
KEGG_REQUEST_DELAY=0.35
KEGG_MAX_RETRIES=3

# Cache
CACHE_TTL_SECONDS=86400

# Statistical defaults
PVALUE_EPSILON=1e-300
FDR_ALPHA=0.05

# Logging
LOG_LEVEL=INFO

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
